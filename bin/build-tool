#!/usr/bin/env bash

set -e

HADOOP_VERSION=3.4.1
GRADER_VERSION="0.1.2"
DOCKER_REGISTRY=${DOCKER_REGISTRY:-"node2.bdcl:5000"}
BASE_IMAGE_NAME="${DOCKER_REGISTRY}/grader-hdfs-base:latest"
DATANODE_IMAGE_NAME="${DOCKER_REGISTRY}/grader-hdfs-datanode:latest"
NAMENODE_IMAGE_NAME="${DOCKER_REGISTRY}/grader-hdfs-namenode:latest"
GRADER_APP_IMAGE_NAME="${DOCKER_REGISTRY}/grader-app:latest"


function show_usage {
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  build-hdfs-images    Build all HDFS Docker images (base, datanode, namenode)"
    echo "  push-hdfs-images     Push the built HDFS Docker images to the registry"
    echo "  build-app-image      Build the grader app Docker image"
    echo "  push-app-image       Push the grader app Docker image to the registry"
    echo "  help                 Show this help message"
}

function build_hdfs_images {
    echo "Building Docker images..."
    echo "Building base image (1 / 3)"
    docker build --build-arg "HADOOP_VERSION=$HADOOP_VERSION" -t "$BASE_IMAGE_NAME" -f ./docker/hdfs-base.dockerfile ./docker
    echo "Building datanode image (2 / 3)"
    docker build --build-arg "BASE_IMAGE=$BASE_IMAGE_NAME" -t "$DATANODE_IMAGE_NAME" -f ./docker/hdfs-datanode.dockerfile ./docker
    echo "Building namenode image (3 / 3)"
    docker build --build-arg "BASE_IMAGE=$BASE_IMAGE_NAME" -t "$NAMENODE_IMAGE_NAME" -f ./docker/hdfs-namenode.dockerfile ./docker
    echo "Build completed successfully!"
}

function push_hdfs_images {
    echo "Pushing Docker images"
    docker push "$BASE_IMAGE_NAME"
    docker push "$DATANODE_IMAGE_NAME"
    docker push "$NAMENODE_IMAGE_NAME"
    echo "Push completed successfully!"
}

function build_app_image {
    echo "Building grader app Docker image..."

    poetry export --without-hashes --format=requirements.txt > requirements.txt

    poetry build
    
    docker build --build-arg "GRADER_VERSION=$GRADER_VERSION" -t "$GRADER_APP_IMAGE_NAME" -f ./docker/app.dockerfile .
    
    echo "Build completed successfully!"
}

function push_app_image {
    echo "Pushing grader app Docker image..."
    docker push "$GRADER_APP_IMAGE_NAME"
    echo "Push completed successfully!"
}

function main {
    # Main CLI logic
    if [ $# -eq 0 ]; then
        show_usage
        exit 1
    fi

    case "$1" in
        build-hdfs-images)
            build_hdfs_images
            ;;
        push-hdfs-images)
            push_hdfs_images
            ;;
        build-app-image)
            build_app_image
            ;;
        push-app-image)
            push_app_image
            ;;
        help)
            show_usage
            ;;
        *)
            echo "Error: Unknown command '$1'"
            show_usage
            exit 1
            ;;
    esac
}

main "$@"

